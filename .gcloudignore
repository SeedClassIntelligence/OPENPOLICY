# Cloud Run source deployments must use the canonical npm lockfile.
# Keeping bun.lock out of the upload prevents Buildpacks from selecting Bun.
bun.lock

# Regulatory research includes the immutable Nevada readiness payloads bundled
# into the authenticated owner console, so it remains in the source upload.
archive/

# Local configuration and generated state must never be uploaded.
.env
.env.*
!.env.example
node_modules/
dist/
data/
output/
.codex/
.git/
.gitignore

