rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection (Private Profiles)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Strict PII protection: no blanket user directory browsing
      allow create: if isOwner(userId) 
        && incoming().id == userId
        && incoming().email is string
        && incoming().email.size() <= 254
        && incoming().role in ['CONSUMER', 'PROVIDER']
        && incoming().keys().hasOnly([
          'id', 'email', 'displayName', 'createdAt', 'role', 'state',
          'currentCarrier', 'agencyName', 'licenseNumber', 'providerStatus'
        ])
        && (incoming().role != 'PROVIDER' || incoming().providerStatus == 'PENDING_VERIFICATION');
      allow update: if isOwner(userId) 
        && incoming().id == existing().id
        && incoming().role == existing().role
        && incoming().get('providerStatus', null) == existing().get('providerStatus', null)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'currentCarrier']);
      allow delete: if false;
    }

    // Challenges Collection (Consumer-Owned Insurance Challenges)
    match /challenges/{challengeId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().referenceNumber is string
        && incoming().status in ['OPEN', 'EVALUATING', 'OFFERS_RECEIVED', 'BOUND', 'ARCHIVED'];
      allow update: if isSignedIn() 
        && existing().userId == request.auth.uid 
        && incoming().userId == request.auth.uid
        && incoming().id == existing().id;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Orders Collection (Accepted Binders & Insurance Orders)
    match /orders/{orderId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().carrier is string
        && incoming().binderStatus in ['ACTIVE', 'PENDING_CARRIER_ISSUE', 'RENEWAL_WINDOW'];
      allow update: if isSignedIn() 
        && existing().userId == request.auth.uid 
        && incoming().userId == request.auth.uid
        && incoming().id == existing().id;
      allow delete: if false; // Historical insurance binding orders cannot be silently deleted
    }

    // Private Vault Collection (Policy Documents, Declarations, Endorsements)
    match /vault/{documentId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().name is string
        && incoming().name.size() <= 255;
      allow update: if isSignedIn() 
        && existing().userId == request.auth.uid 
        && incoming().userId == request.auth.uid
        && incoming().id == existing().id;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // No public connection-test collection: successful SDK initialization is not
    // evidence that an unauthenticated browser should be able to read a document.
  }
}
