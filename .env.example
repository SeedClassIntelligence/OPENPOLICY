# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENPOLICY_MARKET_ENVIRONMENT: SANDBOX (default) or PRODUCTION.
# Market activations are scoped to an environment; a SANDBOX activation can never
# authorize a PRODUCTION transaction. A production deployment must set PRODUCTION.
OPENPOLICY_MARKET_ENVIRONMENT="SANDBOX"

# Public rollout/onboarding availability. Wave 0 Nevada is always enabled;
# Wave 1 West is unlocked by default. Add 2, 3, or 4 through deployment
# configuration only when that regional rollout is authorized. This setting
# never activates a market or substitutes for server-side PR-0A gates.
VITE_OPENPOLICY_UNLOCKED_ROLLOUT_WAVES="1"

# Server authentication defaults to Firebase ID-token verification. Production
# must provide Application Default Credentials or the service-account JSON via
# its secret store. Never commit the JSON value.
OPENPOLICY_AUTH_MODE="firebase"
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
NODE_ENV="production"
# Set true only on a deployment platform where Application Default Credentials
# are intentionally provided by the runtime. Local deployments should instead
# set GOOGLE_APPLICATION_CREDENTIALS to an uncommitted service-account file.
OPENPOLICY_USE_APPLICATION_DEFAULT_CREDENTIALS=false
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Production durable marketplace storage. Cloud Run receives DB_PASSWORD from
# Secret Manager; never commit or expose the password in a VITE_ variable.
OPENPOLICY_REQUIRE_DURABLE_STORAGE="false"
# CLOUD_SQL_INSTANCE="project:region:instance"
# DB_USER="openpolicy_app"
# DB_NAME="openpolicy"
# DB_PASSWORD="[SECRET-MANAGER-ONLY]"
# DATABASE_URL="postgresql://user:password@host/database"
